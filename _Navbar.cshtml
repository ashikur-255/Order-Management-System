<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-3">
    <div class="container-fluid">

        <!-- BRAND -->
        <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">
            OrderManagement
        </a>

        <!-- TOGGLE -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">

            <!-- LEFT -->
            <ul class="navbar-nav me-auto">

                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Order" asp-action="Index">
                            📦 Orders
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="Index">
                            👥 Customers
                        </a>
                    </li>
                }

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                        🔒 Privacy
                    </a>
                </li>

            </ul>

            <!-- RIGHT -->
            <ul class="navbar-nav ms-auto align-items-center">

                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item me-3">
                        <span class="fw-semibold">
                            👋 @User.Identity.Name
                        </span>
                    </li>

                    <li class="nav-item me-3">
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">User</span>
                        }
                    </li>

                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-outline-danger btn-sm">
                                Logout
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item me-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm">
                            Login
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">
                            Register
                        </a>
                    </li>
                }

            </ul>

        </div>
    </div>
</nav>